# ==========================================
# Client-Server Systems Monorepo .gitignore
# ==========================================

# Dependencies & Build outputs (на любом уровне вложенности)
**/node_modules/
**/dist/
**/build/
**/coverage/

# Environment variables & local configuration (везде, где появятся .env)
**/.env
**/.env.*
**/*.local

# IDE & Local configurations (VS Code)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
**/ .vscode/*

# Logs and reports
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Temporary, backup & editor files
**/*.swp
**/*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# Course-specific local materials: KT_3 keeps its materials outside Git.
/KT_3/materials/